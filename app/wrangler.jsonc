// Cloudflare Workers: serve the exported Expo web app (dist) as static files.
// Unknown paths fall back to index.html so links like /gym/123 open the app.
{
  "name": "trainer-manager",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
